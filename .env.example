# Copy this file to ".env" and fill in ONE provider. Never commit .env (it is git-ignored).

# Which provider to use: anthropic or openai. If empty, it is detected from the keys below.
LLM_PROVIDER=

# Optional: model name. If empty, a sensible default for the provider is used.
LLM_MODEL=

# Anthropic (provider=anthropic)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible service (provider=openai)
OPENAI_API_KEY=
# Optional: base URL for OpenAI-compatible services (e.g. OpenRouter, Groq, a local server)
OPENAI_BASE_URL=
